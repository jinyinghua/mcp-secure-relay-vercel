# Client-facing MCP API keys, comma separated. Requests are rejected when unset.
# Generate: openssl rand -base64 48
MCP_API_KEYS=replace-with-a-long-random-client-key

# A base64-encoded 32-byte secret shared with agent/relay-agent.json.
# Generate: openssl rand -base64 32
RELAY_SHARED_SECRET=replace-with-32-byte-base64-secret

# The reachable HTTP endpoint of the remote agent. HTTPS is optional on this hop:
# the request and response bodies are independently AES-256-GCM encrypted and HMAC authenticated.
REMOTE_AGENT_URL=http://relay-host.example.internal:8787/v1/execute

# Match your deployed Vercel URL for MCP protected-resource metadata.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Preferred audit storage: native Redis connection. Redis Cloud normally supplies a rediss:// URL.
# When REDIS_URL is set, it takes precedence over the optional Upstash REST settings below.
REDIS_URL=rediss://default:password@your-redis-cloud-host:port

# Optional compatibility mode when REDIS_URL is not set: Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-redis-rest-token

# Required to read audit records from GET /api/audit. Generate separately.
AUDIT_API_KEY=replace-with-a-separate-long-random-admin-key

# Optional limits. The remote agent applies its own, authoritative limits as well.
RELAY_HTTP_TIMEOUT_MS=25000
MAX_TOOL_RESPONSE_BYTES=65536
